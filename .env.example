# Public URL of the MCP endpoint (used for the OAuth resource id and metadata)
MCP_PUBLIC_URL=https://brand-mcp.example.com/mcp
PORT=3000

# --- OAuth / SSO (Entra ID shown; any OIDC provider works) ---
AUTH_MODE=oidc
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# API app registration: its client id (v2 tokens) and/or App ID URI (v1 tokens)
OIDC_AUDIENCE=<api-client-id>,api://brand-mcp
# scope every token must carry (Entra "scp" short name)
OIDC_REQUIRED_SCOPES=Brand.Read
# scope clients should request, advertised in the protected resource metadata
OIDC_SCOPES_SUPPORTED=api://brand-mcp/Brand.Read
# true: tokens need an app role Brand.All or Brand.<brand-id> to see a brand
BRAND_ROLES_REQUIRED=true

# DNS-rebinding protection: hosts this server answers on
ALLOWED_HOSTS=brand-mcp.example.com

# --- headless browser for check_ad (html), check_page, check_visual ---
# local/Docker: leave empty (Playwright Chromium). Serverless: a remote browser.
# BROWSER_WS_ENDPOINT=wss://playwright.example.com/
# BROWSER_CDP_ENDPOINT=wss://chrome.example.com/?token=...
# hosts rendered HTML may load from (fonts); live-URL checks need the host in BRAND_CHECK_URL_HOSTS
BRAND_CHECK_ASSET_HOSTS=fonts.googleapis.com,fonts.gstatic.com
BRAND_CHECK_URL_HOSTS=

# --- evals ---
# ANTHROPIC_API_KEY=...
# EVAL_MODEL=claude-opus-5-5
# EVAL_MIN_PASS=0.9
