{
  "id": "sonnfeld",
  "name": "Sonnfeld",
  "tokenPrefix": "sf",
  "category": "Dermatological sun care",
  "market": "DE",
  "locale": "de-DE",
  "summary": "Sun care developed with dermatologists. Calm, expert and reassuring. Speaks to adults with “Sie”. Never makes absolute promises of protection.",
  "personality": ["expert", "calm", "reassuring", "precise"],
  "fonts": {
    "display": { "family": "Source Serif 4", "weights": [600, 700], "source": "Google Fonts", "license": "SIL OFL 1.1" },
    "body": { "family": "Source Sans 3", "weights": [400, 600], "source": "Google Fonts", "license": "SIL OFL 1.1" }
  },
  "logos": [
    {
      "id": "primary",
      "file": "logos/primary.svg",
      "use": "Default logo on white and sand surfaces.",
      "backgrounds": ["color.surface.default", "color.surface.subtle", "color.surface.accent"],
      "minWidthPx": 100,
      "minWidthMm": 28,
      "clearSpace": 0.5
    },
    {
      "id": "inverse",
      "file": "logos/inverse.svg",
      "use": "On navy surfaces and on dark sky photography.",
      "backgrounds": ["color.surface.brand", "color.primitive.navy.700"],
      "minWidthPx": 100,
      "minWidthMm": 28,
      "clearSpace": 0.5
    },
    {
      "id": "mark",
      "file": "logos/mark.svg",
      "use": "The rising sun alone. Icons and avatars only.",
      "backgrounds": ["color.surface.default", "color.surface.subtle", "color.surface.brand"],
      "minWidthPx": 24,
      "minWidthMm": 6,
      "clearSpace": 0.25
    }
  ],
  "layout": {
    "minBodyFontPx": 16,
    "minTapTargetPx": 44,
    "maxLineLengthCh": 68,
    "gridColumns": 12,
    "logoPlacement": ["top-left", "top-center"]
  },
  "visual": {
    "minPaletteCoverage": 0.6,
    "requiredColors": ["color.surface.default"]
  }
}
