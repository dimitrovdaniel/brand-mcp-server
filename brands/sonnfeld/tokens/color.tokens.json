    "text": {
      "default": {
        "$value": "{color.primitive.navy.900}"
      },
      "muted": {
        "$value": "{color.primitive.grey.600}"
      },
      "inverse": {
        "$value": "{color.primitive.white}"
      },
      "brand": {
        "$value": "{color.primitive.coral.700}"
      }
    },
    "surface": {
      "default": {
        "$value": "{color.primitive.white}"
      },
      "subtle": {
        "$value": "{color.primitive.sand.50}"
      },
      "brand": {
        "$value": "{color.primitive.navy.900}"
      },
      "accent": {
        "$value": "{color.primitive.sky.100}"
      }
    },
    "action": {
      "primary": {
        "$value": "{color.primitive.coral.700}"
      },
      "primary-hover": {
        "$value": "{color.primitive.navy.900}"
      },
      "on-primary": {
        "$value": "{color.primitive.white}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.primitive.coral.500}"
      },
      "secondary": {
        "$value": "{color.primitive.sky.300}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.primitive.sand.200}"
      }
    },
    "feedback": {
      "error": {
        "$value": "{color.primitive.coral.700}"
      },
      "success": {
        "$value": "{color.primitive.navy.700}"
      }
    }
