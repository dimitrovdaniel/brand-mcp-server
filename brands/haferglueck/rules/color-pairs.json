    {
      "foreground": "color.action.on-primary",
      "background": "color.action.primary",
      "usage": [
        "text",
        "large-text",
        "ui"
      ]
    },
    {
      "foreground": "color.feedback.success",
      "background": "color.surface.default",
      "usage": [
        "text",
        "large-text"
      ]
    }
  ],
  "forbidden": [
    {
      "foreground": "color.text.inverse",
      "background": "color.surface.accent",
      "reason": "White on sun yellow is 1.9:1 and unreadable."
    },
    {
      "foreground": "color.accent.secondary",
      "background": "color.surface.brand",
      "reason": "Berry on forest green vibrates and is 1.7:1."
    },
    {
      "foreground": "color.accent.default",
      "background": "color.surface.default",
      "reason": "Sun yellow on oat is decoration only (1.7:1). Never use it for text."
    }
