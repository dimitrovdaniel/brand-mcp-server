{
  "$description": "Deterministic tool evals: one MCP tool call each, with assertions on the result. Run on every change (npm run eval). Assertions: isError, passed, rules (must include), notRules (must not include), equals ({json.path: value}), includes (substring of the text result).",
  "cases": [
    { "id": "brand-overview-address", "tool": "get_brand", "args": { "brand": "sonnfeld" }, "expect": { "equals": { "addressForm": "sie", "name": "Sonnfeld" } } },
    { "id": "token-primary-hg", "tool": "get_tokens", "args": { "brand": "haferglueck", "group": "color.action.primary" }, "expect": { "equals": { "tokens.0.value": "#1F4D3A", "tokens.0.cssVar": "--hg-color-action-primary" } } },
    { "id": "token-css-radius", "tool": "get_tokens", "args": { "brand": "kiesel", "group": "radius", "format": "css" }, "expect": { "includes": "--ks-radius-md: 4px;" } },
    { "id": "token-dtcg-source", "tool": "get_tokens", "args": { "brand": "sonnfeld", "group": "color.primitive.coral", "format": "dtcg" }, "expect": { "equals": { "color.primitive.coral.500.$value.hex": "#E2603F", "color.primitive.coral.500.$value.colorSpace": "srgb" } } },
    { "id": "find-token-exact", "tool": "find_token", "args": { "brand": "kiesel", "query": "#136A73" }, "expect": { "equals": { "exactMatch": true } } },
    { "id": "find-token-near", "tool": "find_token", "args": { "brand": "haferglueck", "query": "#1f4e3b" }, "expect": { "equals": { "exactMatch": false, "tokens.0.value": "#1F4D3A" } } },
    { "id": "guideline-clear-space", "tool": "search_guidelines", "args": { "brand": "haferglueck", "query": "Abstand um das Logo" }, "expect": { "equals": { "sections.0.id": "logo/clear-space" } } },
    { "id": "guideline-sunscreen-claims", "tool": "search_guidelines", "args": { "brand": "sonnfeld", "query": "sunblock claims" }, "expect": { "equals": { "sections.0.id": "voice-and-copy/sun-protection-claims" } } },
    { "id": "logo-on-brand-surface", "tool": "get_logo", "args": { "brand": "kiesel", "background": "color.surface.brand", "includeSvg": false }, "expect": { "equals": { "variant": "inverse" } } },
    { "id": "logo-on-foreign-colour", "tool": "get_logo", "args": { "brand": "sonnfeld", "background": "#00FF00" }, "expect": { "isError": true } },
    { "id": "ad-specs-leaderboard", "tool": "get_ad_specs", "args": { "brand": "haferglueck", "slot": "leaderboard" }, "expect": { "equals": { "slots.0.width": 728, "slots.0.height": 90, "slots.0.brand.logoPlacement.0": "left" } } },
    { "id": "ad-specs-not-booked", "tool": "get_ad_specs", "args": { "brand": "kiesel", "slot": "billboard" }, "expect": { "isError": true, "includes": "does not book" } },
    { "id": "contrast-forbidden", "tool": "check_contrast", "args": { "brand": "haferglueck", "pairs": [{ "foreground": "color.text.inverse", "background": "color.surface.accent" }] }, "expect": { "passed": false, "rules": ["contrast.forbidden-pair"] } },
    { "id": "contrast-approved", "tool": "check_contrast", "args": { "brand": "sonnfeld", "pairs": [{ "foreground": "color.accent.secondary", "background": "color.surface.brand" }] }, "expect": { "passed": true, "equals": { "results.0.brandStatus": "allowed" } } },
    { "id": "contrast-list-for-bg", "tool": "check_contrast", "args": { "brand": "kiesel", "background": "color.surface.brand" }, "expect": { "includes": "color.text.inverse" } },
    { "id": "copy-hafermilch", "tool": "check_copy", "args": { "brand": "haferglueck", "text": "Unsere Hafermilch schmeckt." }, "expect": { "passed": false, "rules": ["copy.forbidden-term"] } },
    { "id": "copy-sie-for-du-brand", "tool": "check_copy", "args": { "brand": "kiesel", "text": "Füllen Sie einfach nach." }, "expect": { "passed": false, "rules": ["copy.address-form"] } },
    { "id": "copy-biocide-disclaimer", "tool": "check_copy", "args": { "brand": "kiesel", "text": "Der neue Hygienespüler." }, "expect": { "passed": false, "rules": ["copy.required-disclaimer"] } },
    { "id": "copy-sunblocker", "tool": "check_copy", "args": { "brand": "sonnfeld", "text": "Sonnenblocker für die ganze Familie" }, "expect": { "passed": false, "rules": ["copy.forbidden-term"] } },
    { "id": "copy-clean", "tool": "check_copy", "args": { "brand": "sonnfeld", "text": "Sehr hoher Schutz (LSF 50+) für empfindliche Haut. Bitte regelmäßig nachcremen." }, "expect": { "passed": true, "notRules": ["copy.forbidden-term", "copy.address-form"] } },
    { "id": "copy-cta-length", "tool": "check_copy", "args": { "brand": "kiesel", "text": "Jetzt im Onlineshop bestellen", "kind": "cta" }, "expect": { "passed": false, "rules": ["copy.length"] } },
    { "id": "code-hex", "tool": "check_code", "args": { "brand": "haferglueck", "code": ".cta { background: #1F4D3A; color: #FFFFFF; }" }, "expect": { "rules": ["code.hardcoded-color"], "includes": "color.action.primary" } },
    { "id": "code-off-palette", "tool": "check_code", "args": { "brand": "sonnfeld", "code": "const style = { color: '#ff6347' }" }, "expect": { "passed": false, "rules": ["code.off-palette-color"] } },
    { "id": "code-clean", "tool": "check_code", "args": { "brand": "kiesel", "code": ".card { background: var(--ks-color-surface-subtle); border-radius: var(--ks-radius-md); padding: var(--ks-space-4); }" }, "expect": { "passed": true, "equals": { "findings": [] } } },
    { "id": "ad-spec-wrong-size", "tool": "check_ad", "args": { "brand": "haferglueck", "slot": "medium-rectangle", "creative": { "width": 300, "height": 600 } }, "expect": { "passed": false, "rules": ["ad.size"] } },
    { "id": "ad-spec-heavy", "tool": "check_ad", "args": { "brand": "kiesel", "slot": "mobile-banner", "creative": { "fileSizeKb": 120, "fileType": "png" } }, "expect": { "passed": false, "rules": ["ad.file-size"] } },
    { "id": "ad-html-good", "tool": "check_ad", "args": { "brand": "haferglueck", "slot": "medium-rectangle", "html": "@fixture:goodAd" }, "expect": { "passed": true }, "browser": true },
    { "id": "ad-html-bad", "tool": "check_ad", "args": { "brand": "haferglueck", "slot": "medium-rectangle", "html": "@fixture:badAd" }, "expect": { "passed": false, "rules": ["ad.safe-zone", "ad.cta", "logo.size"] }, "browser": true },
    { "id": "page-good", "tool": "check_page", "args": { "brand": "haferglueck", "html": "@fixture:goodPage" }, "expect": { "passed": true }, "browser": true },
    { "id": "page-bad-mobile", "tool": "check_page", "args": { "brand": "haferglueck", "html": "@fixture:badPage", "viewport": { "width": 390, "height": 844 } }, "expect": { "passed": false, "rules": ["page.horizontal-overflow", "a11y.html-has-lang", "page.off-brand-font"] }, "browser": true },
    { "id": "visual-good", "tool": "check_visual", "args": { "brand": "haferglueck", "html": "@fixture:goodPage" }, "expect": { "passed": true }, "browser": true }
  ]
}
